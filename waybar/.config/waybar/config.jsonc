{
    "layer": "top",
    "position": "top",
    "height": 30,

    "modules-left": [
        "hyprland/workspaces",
        "custom/media"
    ],
    "modules-center": [
    ],
    "modules-right": [
        "tray",
	"pulseaudio",
        "network",
        "battery",
        "clock",
        "custom/power",
	"custom/bluetooth"
    ],
    "hyprland/window": {
	"max-lenght": 30
    },

    "hyprland/workspaces": {
        "on-scroll-up": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"-1\" })'",
        "on-scroll-down": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"+1\" })'",
        "smooth-scrolling-threshold": 8
    },

    "custom/bluetooth": {
	"format": "{}",
	"exec": "~/.config/hypr/scripts/waybar-bluetooth.sh",
	"interval": 2,
	"on-click": "~/.config/hypr/scripts/bluetooth.sh",
	"return-type": "json"
    },

//    "custom/media": {
//        "exec": "/home/bielimmeral/.config/hypr/scripts/media.sh",
//        "return-type": "json",
//        "interval": 2
//    },

    "tray": {
	"icon-size": 16,
        "spacing": 0
    },

    "cpu": {
        "format": "{usage}% ",
        "tooltip": false
    },

    "memory": {
        "format": "{}% "
    },

    "network": {
        "format-wifi": " {signalStrength}%",
	"format-icons": ["", "", "", "", ""],
        "format-disconnected": " ⚠",
        "tooltip-format": "{ifname} via {gwaddr} ",
	"on-click": "~/.config/hypr/scripts/wifi-menu.sh"
    },

    "pulseaudio": {
        "scroll-step": 1,
        "format": "{icon} {volume}%",
        "format-muted": " {format_source}",
        "format-source-muted": "",
        "format-icons": {
            "headphone": "",
            "hands-free": "",
            "headset": "",
            "phone": "",
            "portable": "",
            "car": "",
            "default": ["", "", ""]
        },
        "on-click": "pavucontrol"
    },

    "battery": {
        "states": {
            "warning": 30,
            "critical": 15
        },
        "format": "{icon} {capacity}%",
        "format-charging": "{capacity}% ",
        "format-icons": ["", "", "", "", ""]
    },

    "clock": {
        "format": "{:%H:%M}",
        "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>"
    },

    "custom/power": {
        "format": "⏻",
        "tooltip": false,
        "on-click": ".config/hypr/scripts/powermenu.sh"
    }
}
